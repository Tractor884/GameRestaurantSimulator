// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Рейтинг игроков (Task 28): каждая завершённая игра (52 недели или банкротство)
// = отдельная строка истории попыток. Ник берётся из визарда открытия,
// уровень/очки — из computeFinalGrade (rank D−…A+, score1000 0–1000).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayerResult {
  id             String   @id @default(cuid())
  nick           String // 2–24 символа
  restaurantName String
  level          String // ранг A+…D− (computeFinalGrade.rank)
  score          Int // 0–1000
  difficulty     String // novice|standard|professional
  weeksLived     Int // сколько недель прожито
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([score])
}
